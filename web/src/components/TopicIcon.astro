---
// Topic glyphs on the design system's 64px grid. Five come from the design system's
// icon set; taxes and fees has no icon there, so it reuses the prototype's coin shape.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---
<svg width="44" height="44" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {slug === 'homes-and-new-buildings' && (
    <Fragment><path d="M8 30 32 10l24 20z" fill="#2d5a9e"/><rect x="14" y="30" width="36" height="26" fill="#66cdc8"/><rect x="27" y="40" width="10" height="16" rx="5" fill="#d97757"/></Fragment>
  )}
  {slug === 'roads-transit-and-getting-around' && (
    <Fragment><rect x="10" y="10" width="44" height="38" rx="8" fill="#bcc3b5"/><rect x="15" y="16" width="34" height="14" rx="3" fill="#2d5a9e"/><rect x="10" y="34" width="44" height="5" fill="#1aa7e0"/><circle cx="20" cy="50" r="5" fill="#2d5a9e"/><circle cx="44" cy="50" r="5" fill="#2d5a9e"/></Fragment>
  )}
  {slug === 'taxes-fees-and-city-spending' && (
    <Fragment><circle cx="32" cy="32" r="22" fill="#f2b950"/><rect x="29" y="18" width="6" height="28" rx="2" fill="#2d5a9e"/><rect x="20" y="29" width="24" height="6" rx="2" fill="#2d5a9e"/></Fragment>
  )}
  {slug === 'parks-recreation-and-public-spaces' && (
    <Fragment><rect x="6" y="50" width="52" height="8" rx="4" fill="#e5d3b3"/><rect x="29" y="32" width="6" height="20" fill="#2d5a9e"/><circle cx="32" cy="26" r="16" fill="#7cc142"/><circle cx="48" cy="40" r="8" fill="#66cdc8"/></Fragment>
  )}
  {slug === 'water-waste-and-the-environment' && (
    <Fragment><path d="M32 6C24 20 14 30 14 40a18 18 0 0 0 36 0C50 30 40 20 32 6z" fill="#1aa7e0"/><path d="M22 44c4-4 8-4 10 0s6 4 10 0" fill="none" stroke="#faf9f5" stroke-width="3" stroke-linecap="round"/></Fragment>
  )}
  {slug === 'community-services-and-local-rules' && (
    <Fragment><circle cx="22" cy="20" r="8" fill="#d61f5a"/><path d="M8 54a14 14 0 0 1 28 0z" fill="#d61f5a"/><circle cx="42" cy="22" r="8" fill="#d97757"/><path d="M28 56a14 14 0 0 1 28 0z" fill="#d97757"/></Fragment>
  )}
</svg>
