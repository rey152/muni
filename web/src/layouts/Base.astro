---
import '../styles/global.css';
import { asOf } from '../lib/civic';

interface Props {
  title: string;
  description?: string;
  // Which main destination this page belongs to, for aria-current.
  current?: 'home' | 'topics' | 'near' | 'search' | 'comment' | 'about' | 'staff' | '';
}

const { title, description = 'Plain-language explanations of City of Waterloo matters, with every sentence linked to its source.', current = '' } = Astro.props;
const pageTitle = title === 'Muni' ? 'Muni' : `${title} · Muni`;

const topNav = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'topics', href: '/topics/', label: 'Topics' },
  { key: 'near', href: '/near-me/', label: 'Near me' },
  { key: 'search', href: '/search/', label: 'Search' },
  { key: 'comment', href: '/comment/', label: 'Draft check' },
  { key: 'about', href: '/about/', label: 'How it works' },
];

// Five tabs at most on phones (muni-layout ML-N02). Search lives on Home.
const tabs = [
  { key: 'home', href: '/', label: 'Home', icon: 'home' },
  { key: 'topics', href: '/topics/', label: 'Topics', icon: 'topics' },
  { key: 'near', href: '/near-me/', label: 'Near me', icon: 'map' },
  { key: 'comment', href: '/comment/', label: 'Draft check', icon: 'draft' },
  { key: 'about', href: '/about/', label: 'How it works', icon: 'about' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{pageTitle}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap">
  <script is:inline>
    // Runs before paint so the saved theme doesn't flash. The theme choice is the only
    // thing every page stores, and only after someone presses the theme button.
    document.documentElement.classList.add('has-js');
    try {
      var savedTheme = localStorage.getItem('muni-theme');
      if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.setAttribute('data-theme', savedTheme);
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="site-head__row">
      <a class="brand" href="/">
        <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="#2d5a9e"/><circle cx="23" cy="10" r="4.5" fill="#f2b950"/><rect x="6" y="11" width="7" height="15" fill="#1aa7e0"/><path d="M14 19 l5-5 5 5 v7 h-10z" fill="#66cdc8"/></svg>
        <span>Muni</span><span class="sr-only">, home</span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          {topNav.map((item) => (
            <li><a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <button type="button" class="theme-btn js-only" id="theme-btn" aria-pressed="false">
        <svg class="theme-btn__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"/></svg>
        <span class="sr-only">Dark theme</span>
      </button>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="site-foot">
    <div class="site-foot__in">
      <p>Records checked on {asOf}. Muni is independent. It is not the official notice and it is not the City of Waterloo.</p>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/about/">How it works</a></li>
          <li><a href="/sources/">All sources</a></li>
          <li><a href="/search/">Search</a></li>
          <li><a href="/staff/">Staff page</a></li>
          <li><a href="https://www.waterloo.ca/" rel="noopener">City of Waterloo website</a></li>
        </ul>
      </nav>
    </div>
  </footer>

  <nav class="tabbar" aria-label="Main">
    <ul>
      {tabs.map((tab) => (
        <li>
          <a href={tab.href} aria-current={current === tab.key ? 'page' : undefined}>
            {tab.icon === 'home' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 11 12 3l9 8v10h-6v-6H9v6H3z"/></svg>}
            {tab.icon === 'topics' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="3.5"/><rect x="4" y="13" width="7" height="7" rx="3.5"/><rect x="13" y="13" width="7" height="7" rx="2"/></svg>}
            {tab.icon === 'map' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="10" r="6"/><rect x="11" y="10" width="2" height="11"/></svg>}
            {tab.icon === 'draft' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3h10l4 4v14H5z"/></svg>}
            {tab.icon === 'about' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18zm-1 7.5v6h2v-6zm1-4a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6z"/></svg>}
            <span>{tab.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <script>
    import '../scripts/theme';
  </script>
</body>
</html>
